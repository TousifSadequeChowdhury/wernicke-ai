# Copy this file to .env and fill in your real Gemini API key.
# .env.example is safe to commit — it has no real secrets.
# .env is git-ignored — it holds your actual key and never gets pushed.

# --- LLM provider (Gemini, free tier) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Embeddings (runs locally, no API needed) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Retrieval ---
TOP_K=4
MIN_RELEVANCE_SCORE=0.35
GROUNDEDNESS_THRESHOLD=0.35

# --- Rate limiting & safety caps (protects your free Gemini quota) ---
DAILY_QUERY_LIMIT_GLOBAL=200
DAILY_QUERY_LIMIT_PER_IP=20
MAX_FILE_SIZE_MB=10
MAX_DOCUMENTS=50

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
